# ─────────────────────────────────────────────────────────────────────────
# Synapse Academy — environment variables
#
# Everything below is OPTIONAL. With none of these set, the site runs in
# "guest mode": all lessons and quizzes work and progress is saved in the
# learner's browser (localStorage). Set these to enable accounts + cross-device
# progress sync.
# ─────────────────────────────────────────────────────────────────────────

# Postgres connection string.
# Easiest path: add a Neon database from the Vercel Marketplace, which sets
# this automatically in your Vercel project.
DATABASE_URL=

# Auth.js session secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=
